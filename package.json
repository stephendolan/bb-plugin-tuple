{
  "name": "bb-plugin-tuple",
  "version": "1.2.0",
  "description": "Bring live and recorded Tuple calls into bb as explicit, bounded context.",
  "type": "module",
  "scripts": {
    "build": "bb plugin build",
    "storybook": "npm run build && ladle serve",
    "storybook:build": "npm run build && ladle build --outDir .ladle-build",
    "test": "vitest run",
    "test:visual": "npm run storybook:build && playwright test",
    "test:visual:update": "npm run storybook:build && playwright test --update-snapshots",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stephendolan/bb-plugin-tuple.git"
  },
  "homepage": "https://github.com/stephendolan/bb-plugin-tuple#readme",
  "bugs": {
    "url": "https://github.com/stephendolan/bb-plugin-tuple/issues"
  },
  "keywords": [
    "bb",
    "tuple",
    "plugin",
    "transcription"
  ],
  "engines": {
    "bb": ">=0.38",
    "bbPluginSdk": ">=0.4.6"
  },
  "bb": {
    "name": "Tuple",
    "description": "Bring live and recorded Tuple calls into BB threads as explicit, bounded context.",
    "branding": {
      "icon": "./assets/tuple-mark.svg",
      "logo": {
        "light": "./assets/tuple-icon.png"
      }
    },
    "server": "./server.ts",
    "app": "./app.tsx"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.1.3",
    "@hugeicons/react": "^1.1.6",
    "@radix-ui/react-slot": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.4.6",
    "@ladle/react": "^5.1.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "bb-app": "0.38.0",
    "better-sqlite3": "^12.0.0",
    "hono": "^4.11.9",
    "jsdom": "^29.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.8",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11"
  }
}
